{
  "name": "ertho-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./assets/styles.css --minify",
    "build": "npm run build:css && node scripts/build.mjs",
    "dev": "npm run build:css && node scripts/serve.mjs",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./assets/styles.css --watch",
    "preview": "node scripts/serve.mjs dist",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
